{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "となりのワークシート",
  "description": "1 ファイル 1 シート。answer・leak_strings・typical_mistakes・fixed_hints・fixed_check_* はサーバだけが読み、API と印刷には出さない。print はサーバの定数なので書かない。problems が無いファイルは検証で警告し、サーバは読み飛ばす（C の空枠）。",
  "type": "object",
  "required": ["worksheet_id", "title", "grade"],
  "additionalProperties": false,
  "properties": {
    "worksheet_id": {
      "type": "string",
      "pattern": "^WS-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "grade": {
      "type": "string",
      "pattern": "^中[1-3]$"
    },
    "problems": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/problem"
      }
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "required": ["problem_no", "text", "answer", "leak_strings", "typical_mistakes", "fixed_hints"],
      "additionalProperties": false,
      "properties": {
        "problem_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "印刷と GET /worksheets/{id} に出る。数式は半角"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "正誤チェックで GPT にだけ渡す"
        },
        "leak_strings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3,
            "pattern": "^\\S+$",
            "description": "正規化後の形（半角・空白なし）"
          }
        },
        "typical_mistakes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "1 つ目は H1 の stuck_point になる"
        },
        "fixed_hints": {
          "type": "object",
          "required": ["1", "2"],
          "additionalProperties": false,
          "properties": {
            "1": { "$ref": "#/$defs/spokenText" },
            "2": { "$ref": "#/$defs/spokenText" },
            "3": { "$ref": "#/$defs/spokenText" },
            "4": { "$ref": "#/$defs/spokenText" }
          }
        },
        "fixed_check_correct": {
          "$ref": "#/$defs/spokenText",
          "description": "無ければ既定文「正解。その調子」"
        },
        "fixed_check_incorrect": {
          "$ref": "#/$defs/spokenText",
          "description": "無ければ既定文「もう一回、途中の式を見てみて」"
        }
      }
    },
    "spokenText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    }
  }
}
